# Server-only Vercel environment variables (Production).
ACTIVITY_ENABLED=true
# Generate a random token of at least 32 characters. Never put it in frontend code.
ACTIVITY_ADMIN_TOKEN=
# Connect an Upstash Redis database to this Vercel project via Storage/Marketplace.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
